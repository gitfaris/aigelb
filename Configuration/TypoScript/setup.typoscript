plugin.tx_aigelb {
  view {
    templateRootPaths.0 = {$plugin.tx_aigelb.view.templateRootPath}
    partialRootPaths.0 = {$plugin.tx_aigelb.view.partialRootPath}
    layoutRootPaths.0 = {$plugin.tx_aigelb.view.layoutRootPath}
  }

  mvc {
    callDefaultActionIfActionCantBeResolved = 1
  }

}

# Rendering of content elements
lib.tx_aigelb.contentElementRendering = RECORDS
lib.tx_aigelb.contentElementRendering {
  tables = tt_content
  source.current = 1
  dontCheckPid = 1
}

# Include CSS for AI-Gelb Chatbot (conditional on constant)
[{$plugin.tx_aigelb.includeCSS} == 1]
  page.includeCSS {
    aigelb_chatbot = {$plugin.tx_aigelb.cssFile}
    aigelb_chatbot {
      media = all
      forceOnTop = 0
      title = AI-Gelb Chatbot Styles
    }
  }

# Include JS for AI-Gelb Chatbot (conditional on constant)
[{$plugin.tx_aigelb.includeJS} == 1]
  page.includeJSFooter {
    aigelb_chatbot = {$plugin.tx_aigelb.jsFile}
    aigelb_chatbot {
      forceOnTop = 0
      title = AI-Gelb Chatbot Scripts
    }
  }
}

# Check if template override is enabled and apply AI-Gelb paths
[{$plugin.tx_aigelb.settings.enable_template_override} == 1 && traverse(page, "uid") in [{$plugin.tx_aigelb.settings.aigelb_page_uids}]]
    # Override template paths
    page.10.templateRootPaths.0 = {$plugin.tx_aigelb.settings.page_templateRootPath}
    page.10.partialRootPaths.0 = {$plugin.tx_aigelb.settings.page_partialRootPath}
    page.10.layoutRootPaths.0 = {$plugin.tx_aigelb.settings.page_layoutRootPath}

    # template name based on pagelayout
    page.10.templateName >
    page.10.templateName = AIGelb


[END]
