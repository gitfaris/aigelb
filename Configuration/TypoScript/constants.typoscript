# AI-Gelb Extension Constants
# These constants can be overridden in the TYPO3 backend via Template module

plugin.tx_aigelb {
  # Path settings
  view {
    # cat=plugin.tx_aigelb/file; type=string; label=Path to template root (FE)
    templateRootPath = EXT:aigelb/Resources/Private/Frontend/Templates/

    # cat=plugin.tx_aigelb/file; type=string; label=Path to template partials (FE)
    partialRootPath = EXT:aigelb/Resources/Private/Frontend/Partials/

    # cat=plugin.tx_aigelb/file; type=string; label=Path to template layouts (FE)
    layoutRootPath = EXT:aigelb/Resources/Private/Frontend/Layouts/
  }

  # CSS and JS settings
  # cat=plugin.tx_aigelb/enable; type=boolean; label=Include Chatbot CSS
  includeCSS = 1

  # cat=plugin.tx_aigelb/enable; type=boolean; label=Include Chatbot JS
  includeJS = 1

  # cat=plugin.tx_aigelb/file; type=string; label=Path to CSS file
  cssFile = EXT:aigelb/Resources/Public/Css/Chatbot.css

  # cat=plugin.tx_aigelb/file; type=string; label=Path to JS file
  jsFile = EXT:aigelb/Resources/Public/JavaScript/Chatbot.js
}

# ==================================================
# CONSTANTS - AI-Gelb Template Override Configuration
# ==================================================

plugin.tx_aigelb.settings {
    # cat=plugin.tx_aigelb/basic; type=string; label=Page UIDs (comma-separated): All pages will use AI-Gelb template paths
    aigelb_page_uids = 0

    # cat=plugin.tx_aigelb/file; type=string; label=AI-Gelb Template Root Path
    page_templateRootPath = EXT:aigelb/Resources/Private/Page/Templates/

    # cat=plugin.tx_aigelb/file; type=string; label=AI-Gelb Partial Root Path
    page_partialRootPath = EXT:aigelb/Resources/Private/Page/Partials/

    # cat=plugin.tx_aigelb/file; type=string; label=AI-Gelb Layout Root Path
    page_layoutRootPath = EXT:aigelb/Resources/Private/Page/Layouts/

    # cat=plugin.tx_aigelb/enable; type=boolean; label=Enable AI-Gelb Template Override
    enable_template_override = 1
}


# Backend module settings
module.tx_aigelb {
  # cat=module.tx_aigelb/file; type=string; label=Path to backend template root
  templateRootPath = EXT:aigelb/Resources/Private/Templates/Backend/
}
